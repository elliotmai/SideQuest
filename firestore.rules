rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Packs/expansions ("decks") are readable by anyone signed in; only an admin
    // account (isAdmin set manually on their user doc) can create/edit/delete them.
    match /packs/{packId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /expansions/{expansionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Username uniqueness: doc id is the lowercased username, value is its owner's
    // uid. "create" only fires when no doc exists yet at that id, so two users
    // racing to claim the same name have the second one rejected server-side
    // instead of silently overwriting the first (see lib/usernames.js). Nobody
    // can ever "update" an existing claim — only its owner deleting it (to free
    // the name when renaming) and someone else creating a fresh one after.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Any signed-in user (anonymous auth counts) can read/write their own profile,
    // and read others' (needed for username lookup / friend search).
    match /users/{uid} {
      allow read: if request.auth != null;
      // A user can freely write their own profile, but can't grant themselves
      // isAdmin — that field can only carry over unchanged (or be touched by an
      // existing admin), so it must be set by hand in the Firebase console.
      allow write: if request.auth != null && request.auth.uid == uid &&
        (!('isAdmin' in request.resource.data) ||
          (resource != null && request.resource.data.isAdmin == resource.data.isAdmin) ||
          isAdmin());

      // Friendship is bidirectional (see lib/friends.js), which means adding
      // or removing a friend has to write to *someone else's* doc too. This
      // narrow rule allows exactly that and nothing else: another signed-in
      // user may add or remove only their own uid from this doc's `friends`
      // array — every other field, and every other entry in that array,
      // must come out identical to how it went in.
      allow update: if request.auth != null && request.auth.uid != uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']) &&
        request.resource.data.friends.removeAll([request.auth.uid])
          == resource.data.friends.removeAll([request.auth.uid]);
    }

    // Friend groups: readable/writable by members only.
    match /groups/{groupId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.members;
    }

    // Sessions are open to anyone with the code (that's the point of a shareable link).
    match /sessions/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.hostUid;
      allow update: if request.auth != null;

      match /players/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /events/{eventId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
        allow update, delete: if false;
      }
    }
  }
}
