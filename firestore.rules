rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in user (anonymous auth counts) can read/write their own profile,
    // and read others' (needed for username lookup / friend search).
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Friend groups: readable/writable by members only.
    match /groups/{groupId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.members;
    }

    // Sessions are open to anyone with the code (that's the point of a shareable link).
    match /sessions/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.hostUid;
      allow update: if request.auth != null;

      match /players/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /events/{eventId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
        allow update, delete: if false;
      }
    }
  }
}
